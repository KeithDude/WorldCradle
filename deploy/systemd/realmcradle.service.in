[Unit]
Description=RealmCradle — game-server dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __VARS__ are filled in by setup.sh
Environment=REALMCRADLE_HOME=__DATA__
Environment=REALMCRADLE_VENV=__VENV__
WorkingDirectory=__CODE__/app
# gunicorn (production WSGI) terminating TLS directly on the dashboard's port.
# ONE worker so there is a single background poller / alert engine. The gevent
# worker handles many connections at once, so clients that connect and then go
# quiet (scanners, slow-request attacks) can't use up the dashboard's capacity.
# Long timeout so slow systemctl stop/restart actions aren't killed.
# Repairs the Python environment first if an OS upgrade changed Python, and installs the
# libraries a new RealmCradle version needs (can take a few minutes).
ExecStartPre=__CODE__/bin/realmcradle-ensure-venv
TimeoutStartSec=900
ExecStart=__VENV__/bin/gunicorn \
    --workers 1 --worker-class gevent --worker-connections 1000 --keep-alive 30 --timeout 300 \
    --bind 0.0.0.0:__PORT__ \
    --certfile __DATA__/certs/cert.pem \
    --keyfile __DATA__/certs/key.pem \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
