[Unit]
Description=GameDash — game-server dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __VARS__ are filled in by setup.sh
Environment=GAMEDASH_HOME=__DATA__
WorkingDirectory=__APP__
# gunicorn (production WSGI) terminating TLS directly on 8443.
# ONE worker so there is a single background poller / alert engine. The gevent
# worker handles many connections at once, so clients that connect and then go
# quiet (scanners, slow-request attacks) can't use up the dashboard's capacity.
# Long timeout so slow systemctl stop/restart actions aren't killed.
# Repairs the Python environment first if an OS upgrade changed Python (can take a few minutes).
ExecStartPre=__APP__/../bin/gamedash-ensure-venv
TimeoutStartSec=900
ExecStart=__VENV__/bin/gunicorn \
    --workers 1 --worker-class gevent --worker-connections 1000 --keep-alive 5 --timeout 300 \
    --bind 0.0.0.0:8443 \
    --certfile __DATA__/certs/cert.pem \
    --keyfile __DATA__/certs/key.pem \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
