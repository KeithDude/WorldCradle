[Unit]
Description=WorldCradle — daily backup of all server saves
After=network-online.target

[Service]
Type=oneshot
Environment=WORLDCRADLE_HOME=__DATA__
WorkingDirectory=__CODE__/app
ExecStart=__VENV__/bin/python __CODE__/app/backups.py all
# don't pin the box if a backup is slow; saves are flushed per-server internally
TimeoutStartSec=1800
