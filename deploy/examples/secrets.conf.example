# secrets.conf — the two shared game-server passwords. Keep mode 0600.
#
# Sourced by the generated per-server run scripts (valid bash: KEY="value") and
# read by RealmCradle. Change these here OR in the dashboard (Settings →
# Game-server passwords), then RESTART the affected servers to apply.
#
# Allowed characters: letters, digits, and  ! @ # % ^ & * ( ) _ + - = : . ,
# (no spaces, quotes, $, backtick or backslash — they break the launch scripts).
#
# Note: Satisfactory stores its admin password in-game, not here.

GAME_SERVER_PASSWORD="change-me-join"
GAME_ADMIN_PASSWORD="change-me-admin"
