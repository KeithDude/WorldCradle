#!/bin/sh
# WorldCradle package: after installing or upgrading.
set -e

# Python can't write its byte-code cache into this system folder while WorldCradle runs as a normal
# user, so make it now (the same Python the users' WorldCradle environments are built from).
python3 -m compileall -q /usr/lib/worldcradle/app >/dev/null 2>&1 || true

if [ "$1" = configure ]; then
    # the jobs that need administrator rights (starting with the computer, the firewall, fail2ban),
    # done now — the person typed sudo for this — so `worldcradle setup` never asks for a password
    /usr/lib/worldcradle/bin/worldcradle-system-setup "${SUDO_USER:-}" || true
    if [ -n "$2" ]; then
        # An upgrade: restart the dashboard of every account that runs one, so the new version
        # takes over. It installs any new Python libraries it needs as it starts.
        for dir in /run/user/*; do
            [ -d "$dir" ] || continue
            user="$(getent passwd "${dir##*/}" | cut -d: -f1)"
            [ -n "$user" ] || continue
            if systemctl --user -M "$user@" is-active --quiet worldcradle.service 2>/dev/null; then
                systemctl --user -M "$user@" restart --no-block worldcradle.service 2>/dev/null \
                    && echo "WorldCradle: restarting the dashboard for $user." || true
            fi
        done
    else
        echo
        echo "WorldCradle is installed. To set it up, type this as your normal user (no 'sudo'):"
        echo
        echo "    worldcradle setup"
        echo
    fi
fi
exit 0
