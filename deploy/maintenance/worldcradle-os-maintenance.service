[Unit]
Description=worldcradle: OS package maintenance (player-aware, reboots if required)
Documentation=https://github.com/KeithDude/WorldCradle/blob/main/deploy/maintenance/install.md
# Needs the network for apt, and the dashboard up for the player check.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/worldcradle-os-maintenance.sh
# apt on a slow mirror plus a graceful ARK shutdown can legitimately take a
# while; don't let systemd kill the run mid-dist-upgrade.
TimeoutStartSec=3600
# The script reboots the box itself when required, so a clean exit is expected
# even on the runs that end in a restart.
SuccessExitStatus=0
