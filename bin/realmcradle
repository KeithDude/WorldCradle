#!/bin/sh
# realmcradle — command-line tools for RealmCradle. "realmcradle help" lists them.
# A git checkout links ~/.local/bin/realmcradle here (setup.sh); the package installs /usr/bin/realmcradle.
REALMCRADLE_CODE="$(dirname "$(dirname "$(readlink -f "$0")")")"
# use the same data folder as the running dashboard
if [ -z "${REALMCRADLE_HOME:-}" ]; then
    REALMCRADLE_HOME="$(systemctl --user show realmcradle.service -p Environment --value 2>/dev/null \
                     | tr ' ' '\n' | sed -n 's/^REALMCRADLE_HOME=//p')"
    [ -n "$REALMCRADLE_HOME" ] || unset REALMCRADLE_HOME
fi
. "$REALMCRADLE_CODE/bin/realmcradle-env.sh"
# "realmcradle setup" builds everything (Python environment included), so it runs before the rest
if [ "${1:-}" = setup ]; then
    shift
    exec bash "$REALMCRADLE_CODE/setup.sh" "$@"
fi
# repair the Python environment first if a system upgrade broke it
"$REALMCRADLE_CODE/bin/realmcradle-ensure-venv" || exit 1
exec "$REALMCRADLE_VENV/bin/python" "$REALMCRADLE_CODE/app/cli.py" "$@"
